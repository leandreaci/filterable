{
    "name": "leandreaci/filterable",
    "version": "1.10.0",
    "description": "Filter package to Laravel/Lumen",
    "type": "package",
    "authors": [
        {
            "name": "Leandro Andreaci",
            "email": "leandroandreaci@hotmail.com"
        }
    ],
    "require": {
        "php": "8.2",
        "illuminate/database": "^v10.48.28",
        "illuminate/http": "^v10.48.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "Leandreaci\\Filterable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leandreaci\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
